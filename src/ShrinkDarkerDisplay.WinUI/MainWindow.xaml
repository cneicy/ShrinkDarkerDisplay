<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ShrinkDarkerDisplay.App.MainWindow">
    <Grid x:Name="Root" Padding="24,20,24,14" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock x:Name="TitleText" Text="屏幕调暗" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <Button x:Name="DismissButton" Content="" FontFamily="Segoe Fluent Icons" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Click="DismissClick" AutomationProperties.Name="收起"/>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="8">
                <ToggleButton x:Name="EnabledTile" Height="48" HorizontalAlignment="Stretch" IsChecked="True" Click="EnabledClick" Content="" FontFamily="Segoe Fluent Icons" FontSize="20"/>
                <TextBlock x:Name="EnabledLabel" Text="调暗" HorizontalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="8">
                <ToggleButton x:Name="NightTile" Height="48" HorizontalAlignment="Stretch" Click="NightClick" Content="" FontFamily="Segoe Fluent Icons" FontSize="20"/>
                <TextBlock x:Name="NightLabel" Text="深色模式" HorizontalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="8">
                <ToggleButton x:Name="SystemTile" Height="48" HorizontalAlignment="Stretch" Click="SystemClick" Content="" FontFamily="Segoe Fluent Icons" FontSize="20"/>
                <TextBlock x:Name="SystemLabel" Text="跟随系统" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
        <ScrollViewer x:Name="BrightnessScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
            <StackPanel x:Name="BrightnessContent" Spacing="14" Margin="0,0,24,0">
                <Grid>
                    <TextBlock x:Name="MasterLabel" Text="总亮度"/>
                    <TextBlock x:Name="MasterValue" HorizontalAlignment="Right"/>
                </Grid>
                <Slider x:Name="Master" Minimum="10" Maximum="100" Value="100" ValueChanged="MasterChanged" AutomationProperties.Name="总亮度"/>
                <StackPanel x:Name="DisplayRows" Spacing="14"/>
                <TextBlock x:Name="Status" FontSize="12" TextWrapping="Wrap" Opacity="0.7"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="AboutButton" Content="关于" Click="AboutClick"/>
            <Button x:Name="ExitButton" Content="退出" Click="ExitClick"/>
        </StackPanel>
    </Grid>
</Window>
